{
  "info": {
    "name": "Library API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Opret lån - gyldigt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"memberId\": 1, \"isbn\": \"9780306406157\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Svartid under 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "pm.test(\"Lånet har de forventede felter\", () => {",
              "  const l = pm.response.json();",
              "  pm.expect(l.id).to.be.a(\"number\");",
              "  pm.expect(l.memberId).to.eql(1);",
              "  pm.expect(l.bookIsbn).to.eql(\"9780306406157\");",
              "  pm.expect(l.dueDate).to.be.a(\"string\");",
              "  pm.expect(l.returnedDate).to.be.null;",
              "});",
              "pm.collectionVariables.set(\"loanId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Hent lån - findes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/loans/{{loanId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans",
            "{{loanId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lånet matcher det oprettede\", () => {",
              "  const l = pm.response.json();",
              "  pm.expect(l.id).to.eql(Number(pm.collectionVariables.get(\"loanId\")));",
              "  pm.expect(l.bookIsbn).to.eql(\"9780306406157\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Opret lån - ugyldigt ISBN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"memberId\": 1, \"isbn\": \"123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Svar har error-felt\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Opret lån - bog allerede udlånt",
